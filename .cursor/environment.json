{
  "name": "GigaAgent",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "export PATH=\"$HOME/.local/bin:$PATH\"; cd backend && uv run giga_agent dev"
    },
    {
      "name": "frontend",
      "command": "cd front && npm run dev"
    }
  ],
  "ports": [
    { "name": "backend", "port": 9090 },
    { "name": "frontend", "port": 3000 }
  ]
}
